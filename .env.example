# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/mlesson?schema=public"

# Auth.js configuration
# Generate with: npx auth secret  (or `openssl rand -base64 32`)
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Seed-only: credentials for the initial admin user created by prisma/seed.ts
SEED_ADMIN_EMAIL="admin@mlesson.school"
SEED_ADMIN_PASSWORD="change-me-please"

# Optional cloud media storage (site works with local/demo URLs without these).
# Leave empty to use the local storage stub in src/lib/storage.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
